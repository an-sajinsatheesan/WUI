# --- Server ---
PORT=3000
NODE_ENV=development

# --- MongoDB Atlas (existing M0 cluster) ---
# Copy the connection string from Atlas > Connect > Drivers. Leave the path empty or
# point it anywhere: the app always uses the database named in MONGODB_DB.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Dedicated database for this app. Do not change to an existing database.
MONGODB_DB=whatsapp_mvp

# --- Auth ---
# Long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# --- CORS ---
# Comma-separated frontend origins. Wildcards allowed for a single subdomain label.
# Local:      http://localhost:4200
# Production: https://your-frontend.vercel.app
CORS_ORIGINS=http://localhost:4200

# --- WhatsApp provider ---
# "mock" simulates messages. Add a real provider in src/providers later.
WHATSAPP_PROVIDER=mock
# Optional shared secret required in the x-webhook-token header on /api/webhooks/whatsapp
WEBHOOK_TOKEN=
