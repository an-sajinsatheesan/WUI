# --- Server ---
PORT=3000
NODE_ENV=development

# --- MongoDB Atlas (existing M0 cluster) ---
# Copy the connection string from Atlas > Connect > Drivers. Leave the path empty or
# point it anywhere: the app always uses the database named in MONGODB_DB.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Dedicated database for this app. Do not change to an existing database.
MONGODB_DB=whatsapp_mvp

# --- Auth ---
# Long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# --- CORS ---
# Comma-separated frontend origins. Wildcards allowed for a single subdomain label.
# Local:      http://localhost:4200
# Production: https://your-frontend.vercel.app
CORS_ORIGINS=http://localhost:4200

# --- WhatsApp providers ---
# Provider type and API keys are set per WhatsApp account in the app (WhatsApp Accounts page, admin only).
# Default provider for new accounts:
WHATSAPP_PROVIDER=mock
# Key used to encrypt provider API keys/tokens in MongoDB (AES-256-GCM). Falls back to JWT_SECRET.
# If you change it later, re-enter the provider keys.
ENCRYPTION_KEY=
# Optional shared secret for incoming webhooks: append ?token=... to the webhook URL or send x-webhook-token.
WEBHOOK_TOKEN=
# Verify token you type into the Meta App dashboard when registering the webhook URL.
META_VERIFY_TOKEN=

# Seed demo data automatically on first request when the database has no users (handy on Vercel).
SEED_ON_EMPTY=false
